# Configurações do Supabase para o Assistente Show
NEXT_PUBLIC_SUPABASE_URL=https://sua-url-supabase.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=seu-anon-key-aqui

# Apenas servidor. Configure valores reais no ambiente, nunca no repositório.
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
# Gere um segredo aleatório novo (pelo menos 16 caracteres).
CRON_SECRET=
# Remetente de um domínio próprio validado no Resend. Sem fallback de teste.
WEEKLY_REPORT_FROM=
# Provedor: resend (padrão) ou gmail. Gmail não depende de RESEND_API_KEY.
WEEKLY_REPORT_PROVIDER=resend
GMAIL_USER=
# Senha de aplicativo do Google: somente no servidor, como Secret na Vercel.
GMAIL_APP_PASSWORD=
